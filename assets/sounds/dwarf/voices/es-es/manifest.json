      "order_attack": [
        "¡Por el honor del clan!",
        "¡Los partiré en dos!",
        "¡Sin piedad ni miedo!",
        "¡Que tiemble su carne!",
        "¡A por ellos, por mis ancestros!",
        "¡Mi hacha tiene hambre!"
      ],
      "attack": [
        "¡Por las montañas!",
        "¡Sentid mi hacha!",
        "¡Por mi barba!",
        "¡Caed, cobardes!",
        "¡Honor y acero!",
        "¡Piedra y fuego!"
